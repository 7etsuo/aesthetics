{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aesthetics.local/schemas/vector.schema.json",
  "title": "VisualBasisVector",
  "type": "object",
  "required": [
    "id",
    "canonical_name",
    "family_id",
    "status",
    "definition",
    "testable_claim",
    "low_pole",
    "high_pole"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^vec_[a-z][a-z0-9_]*$" },
    "canonical_name": { "type": "string", "minLength": 2 },
    "family_id": { "type": "string", "pattern": "^fam_[a-z][a-z0-9_]*$" },
    "status": {
      "type": "string",
      "enum": [
        "canonical",
        "provisional",
        "candidate",
        "composite",
        "system",
        "rejected",
        "vague"
      ]
    },
    "definition": { "type": "string", "minLength": 8 },
    "testable_claim": { "type": "string", "minLength": 8 },
    "low_pole": { "type": "string" },
    "high_pole": { "type": "string" },
    "polarity": { "type": "string", "enum": ["unipolar", "bipolar"] },
    "aliases": { "type": "array", "items": { "type": "string" } },
    "nearby_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^vec_[a-z][a-z0-9_]*$" }
    },
    "not_the_same_as": { "type": "object", "additionalProperties": { "type": "string" } },
    "observable_effects": { "type": "array", "items": { "type": "string" } },
    "prompt_phrases": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "scoring_guidance": { "type": "string" },
    "open_questions": { "type": "array", "items": { "type": "string" } },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "study_ids": { "type": "array", "items": { "type": "string" } },
    "observation_ids": { "type": "array", "items": { "type": "string" } },
    "validation": { "type": "object" },
    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
